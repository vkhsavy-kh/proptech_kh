{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proptech",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "APP_NAME": "PropTech",
    "APP_URL": "https://proptech.genzkh855.workers.dev",
    "TELEGRAM_REDIRECT_URI": "https://proptech.genzkh855.workers.dev/auth/telegram/callback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "proptech-db",
      "database_id": "96bc5b79-bcaf-4cba-b3b4-655d31378b76",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "d8b9e38dd3bc4d30afbc8e1a9959b8d3"
    }
  ],
  "queues": {
    "producers": [
      { "binding": "NOTIFICATIONS", "queue": "proptech-notifications" }
    ]
  }
}
